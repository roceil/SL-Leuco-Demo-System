# 前端 API base URL
# 開發環境留空即可，會自動透過 Vite proxy 轉發到 http://localhost:3001
# 部署到 Zeabur 時設定為 json-server 服務的對外網址，例如：
#   VITE_API_BASE_URL=https://sl-leuco-demo-server.zeabur.app
VITE_API_BASE_URL=

# 開發時 Vite proxy 要轉發到的 json-server 位址（預設 http://localhost:3001）
VITE_DEV_API_TARGET=http://localhost:3001
